  <ItemGroup>
    <ProjectReference Include="..\..\src\dotNetBlocks.System\dotNetBlocks.System.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
