<!--
Test project build properties.
Automatically Only included in build if marked or detected as test project.
-->
<Project>


	<PropertyGroup>
		<IsPackable>False</IsPackable>

		<NuGetAudit>false</NuGetAudit>
		<WarningLevel>3</WarningLevel>
		<AnalysisLevel>preview</AnalysisLevel>
		<Features>strict</Features>
		 <NoWarn>IDE1006</NoWarn> <!-- Ignore naming style warnings in test projects -->

		<!-- No xml documentation-->
    <GenerateDocumentationFile> False </GenerateDocumentationFile>

	</PropertyGroup>

	<ItemGroup >
		<PackageReference Include="Shouldly" />    

        <Using Include="Shouldly" />
    </ItemGroup>

	<PropertyGroup>
		<CompatibilityTargetFrameworks>netstandard2.0</CompatibilityTargetFrameworks>
		<DefaultTargetFrameworks>net8.0</DefaultTargetFrameworks>
		<TestingPlatformShowTestsFailure>True</TestingPlatformShowTestsFailure>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<SourceLinkCreate>false</SourceLinkCreate>
	</PropertyGroup>



</Project>