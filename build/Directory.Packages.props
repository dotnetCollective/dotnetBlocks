<Project>
  <PropertyGroup>

      <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true </ManagePackageVersionsCentrally>

    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>

  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="RT.Comb" Version="4.0.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />    

    <PackageVersion Include="System.IO.Hashing" Version="9.0.9" />
    <PackageVersion Include="System.IO.Pipelines" Version="9.0.9" />
    <PackageVersion Include="System.IO.Pipes" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageVersion Include="MassTransit" Version="8.5.3" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="9.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.9"/>
    <PackageVersion Include="LinqKit.Core" Version="1.2.8"/>

    <!--Documentation generator Statiq-->

<!--
    Working
    <PackageVersion Include="Statiq.Web" Version="1.0.0-beta.60"  />
	<PackageVersion Include="Statiq.Docs" Version="1.0.0-beta.17" />

     Floating
    <Packageversion Include="Statiq.Docs"   Version="*-*" />
	<PackageVersion Include="Statiq.Web" Version="*-*" />

    -->

    <Packageversion Include="Statiq.Docs"   Version="1.0.0-beta.17"  />
    <Packageversion Include="Statiq.Web"   Version="1.0.0-beta.60"  />


  </ItemGroup>
</Project>
