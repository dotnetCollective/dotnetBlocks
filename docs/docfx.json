{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ "**/*dotnetblocks*/bin/**/dotnetblocks*.dll" ],
          "src": "../src"
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "filter": "filterConfig.yml"
    },
    {
      "properties": {
        "TargetFramework": "net9.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.md", "**/*.{md,yml}" ],
        "exclude": [ "api/**" ],
        "dest": ""
      },
      {
        "files": [ "**/*.{yml,md}", "*.{md,yml}" ],
        "exclude": [ "**/*Private*" ],
        "src": "api",
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ],
        "dest": ""
      },
      {
        "files": [ "images/favicon*.*" ],
        "dest": ""

      }
    ],
    "overwrite": [],
    "globalMetadata": {
      "_appTitle": "DotNetBlocks",
      "_appFooter": "<span>Copyright © Brian Rogers - DotNetBlocks.<br>Generated by <strong>DocFX</strong></span>",
      "_appLogoPath": "Images/DotNetBlocks.svg",
      "_appFavIconPath": "Images/favicon.ico",
      "_enableSearch": "true"
    },
    "template": [
      "default",
      "modern",
      "templates/material",
      "material/material"
    ],
    "output": "../docs_site/",
    "markdownEngineProperties": {
      "markdigExtensions": [ "attributes" ]
    },
    "postProcessors": [ "ExtractSearchIndex" ]
  }

}
